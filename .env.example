# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Variables set on the command line (e.g. by the npm scripts via cross-env) take precedence.

# Environment file to load from Core/Config/Environments/<TEST_ENV>.json (dev | qa | staging | prod). Default: qa
TEST_ENV=qa

# Log level for Reports/Logs/automation.log and console: error | warn | info | http | verbose | debug | silly. Default: info
LOG_LEVEL=info

# Optional overrides of the environment JSON (leave unset to use the JSON values)
# ANDROID_DEVICE_NAME=nightwatch-android-11
# ANDROID_PLATFORM_VERSION=11
# ANDROID_UDID=emulator-5554
# APPIUM_HOST=127.0.0.1
# APPIUM_PORT=4723

# APK path, only needed when the framework installs the app (currently the app must be pre-installed)
ANDROID_APP_PATH=./Apps/app-release.apk

# Test account for the login flow (not automated yet)
# TEST_USERNAME=
# TEST_PASSWORD=
