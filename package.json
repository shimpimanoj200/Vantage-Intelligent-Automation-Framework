{
  "name": "vantage-intelligent-automation-framework",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium mobile test automation framework for the Vantage Android app",
  "private": true,
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test:android": "cross-env PLATFORM=android wdio run ./wdio.conf.ts",
    "test:android:dev": "cross-env TEST_ENV=dev PLATFORM=android wdio run ./wdio.conf.ts",
    "test:android:qa": "cross-env TEST_ENV=qa PLATFORM=android wdio run ./wdio.conf.ts",
    "test:android:staging": "cross-env TEST_ENV=staging PLATFORM=android wdio run ./wdio.conf.ts",
    "test:android:prod": "cross-env TEST_ENV=prod PLATFORM=android wdio run ./wdio.conf.ts",
    "typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "allure:clean-report": "node -e \"require('fs').rmSync('Reports/Allure/allure-report', { recursive: true, force: true })\"",
    "allure:generate": "npm run allure:clean-report && allure generate ./Reports/Allure/allure-results -o ./Reports/Allure/allure-report",
    "allure:open": "allure open ./Reports/Allure/allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimpimanoj200/Vantage-Intelligent-Automation-Framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shimpimanoj200/Vantage-Intelligent-Automation-Framework/issues"
  },
  "homepage": "https://github.com/shimpimanoj200/Vantage-Intelligent-Automation-Framework#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure": "^3.18.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "cross-env": "^10.1.0",
    "expect-webdriverio": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  }
}
