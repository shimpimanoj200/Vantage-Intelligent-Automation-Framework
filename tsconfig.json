{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "mocha"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "config/**/*.ts"
  ]
}