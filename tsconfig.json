{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "@wdio/globals/types",
      "expect-webdriverio",
      "@wdio/mocha-framework",
      "@wdio/appium-service",
      "mocha"
    ]
  },
  "include": [
    "Core/**/*.ts",
    "Fixtures/**/*.ts",
    "Mobile/**/*.ts",
    "Screens/**/*.ts",
    "Macros/**/*.ts",
    "test/**/*.ts",
    "wdio.conf.ts"
  ]
}
